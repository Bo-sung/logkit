<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LogServer</RootNamespace>
    <AssemblyName>LogServer</AssemblyName>
    <!-- 서버 GC가 힙을 작업량에 맞춰 줄이도록(DATAS). 기본 서버 GC는 코어 수만큼 힙을 잡아 유휴 때도 수 GB를 쥐고 있다. -->
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
  </PropertyGroup>

  <!-- 게임 이벤트 규약·카탈로그 JSON은 출력 디렉터리로 복사해 기동 시 함께 로딩한다 -->
  <ItemGroup>
    <None Update="GameConfig\game-events.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="GameConfig\raid-stages.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="GameConfig\module-catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="GameConfig\customer-catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

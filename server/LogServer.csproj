<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    공통 로그 수신 서버(ingest). 업로드 수신·저장·GM툴 열람·휴지통·분석 서버용 내보내기 API를 담당한다.
    저장 코드는 core/LogKit.Core 프로젝트를, 게임별 분석은 analytics/* 프로젝트를 따로 빌드한다.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LogServer</RootNamespace>
    <AssemblyName>LogServer</AssemblyName>
    <!-- 서버 GC가 힙을 작업량에 맞춰 줄이도록(DATAS). 기본 서버 GC는 코어 수만큼 힙을 잡아 유휴 때도 수 GB를 쥐고 있다. -->
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- core와 analytics는 각자 프로젝트이므로 이 프로젝트의 소스에서 제외한다 -->
    <Compile Remove="core/**;analytics/**" />
    <Content Remove="core/**;analytics/**" />
    <None Remove="core/**;analytics/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="core/LogKit.Core.csproj" />
  </ItemGroup>

</Project>
